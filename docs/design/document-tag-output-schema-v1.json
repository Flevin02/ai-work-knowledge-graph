{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "document-tag-v1",
  "title": "DocumentTagOutputV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "summary",
    "tags",
    "evidences"
  ],
  "properties": {
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "tags": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "candidateId",
          "name",
          "confidence",
          "evidenceIds"
        ],
        "properties": {
          "candidateId": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 24
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "evidenceIds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "evidences": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "evidenceId",
          "sourceDocumentId",
          "chunkId",
          "sectionPath",
          "quote"
        ],
        "properties": {
          "evidenceId": {
            "type": "string",
            "minLength": 1
          },
          "sourceDocumentId": {
            "type": "string",
            "minLength": 1
          },
          "chunkId": {
            "type": "string",
            "minLength": 1
          },
          "sectionPath": {
            "type": "string"
          },
          "quote": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
